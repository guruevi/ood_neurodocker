<%-

  cores_lookup = {
      "any" => {"general" => 64},
      "gpu" => {"general" => 64},
  }

  slurm_args = []

  # GPU type
  gpu = gpu.blank? ? 0 : gpu.to_i
  node_type = gpu > 0 ? "gpu" : "any"

  if gpu > 0
    slurm_args = %W[--gres gpu:l40s.#{gpu}g:1]
  end


  max_cores = cores_lookup[node_type][cluster]
  num_cores = cores.blank? ? 0 : cores.to_i
  if num_cores > max_cores
    num_cores = max_cores
  end

  req_mem = (respond_to?(:memory) ? send(:memory) : (defined?(memory) ? memory : nil))
  req_mem = req_mem.to_s.strip
  mem_val = req_mem.empty? ? nil : req_mem.to_i

  if mem_val.nil? or mem_val <= 0
    mem_val = num_cores * (memory_multiplier.blank? ? 1024 : memory_multiplier.to_i)
  end

  if mem_val > 261144
    mem_val = 261144 # Limit to slightly less than 256GB
  end
%>
---
batch_connect:
  template: "basic"
script:
  native:
    - "--cpus-per-task"
    - "<%= num_cores %>"
    - "--mem"
    - "<%= mem_val %>"
    - "--nodes"
    - "1"
  <%- slurm_args.each do |arg| %>
    - "<%= arg %>"
  <%- end %>
