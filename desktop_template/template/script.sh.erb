#!/usr/bin/env bash
export SINGULARITY_BIND="/mnt,/tmp,/run,/opt/ood_apps"
export SINGULARITYENV_PS1="${debian_chroot:+($debian_chroot)}\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ "

export SINGULARITYENV_PREPEND_PATH=""
export SINGULARITYENV_APPEND_PATH=""

<% if context.gpu.present? and context.gpu.to_i > 0 %>
  SINGULARITY_OPTIONS='--nv'
<% end %>
# This runs ttyd and tmux on the host because there are issues with RHEL7 in containers (devpts)
/opt/ood_apps/bin/ttyd -W -p "$port" -b "/node/${host}/${port}" -c "ttyd:${password}" -w "$HOME" \
    -t 'cursorStyle=bar' \
    -t 'cursorBlink=true' \
    -t 'theme={"background": "#282a3a", "foreground": "#f8f8f2"}' \
    -t enableSixel=true \
    -t enableTrzsz=true \
    tmux -L "J${SLURM_JOB_ID}.sock" new -A -s "J${SLURM_JOB_ID}" \
        singularity exec ${SINGULARITY_OPTIONS} \
        "/opt/ood_apps/images/<%= context.bc_account %>/<%= context.bc_account %>_<%= context.app_version %>.sif" \
        /bin/bash -l